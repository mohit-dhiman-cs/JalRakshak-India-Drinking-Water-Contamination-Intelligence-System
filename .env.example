# ==========================================
# JalRakshak Environment Configuration Template
# ==========================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Fill in the variables below with your actual API keys
# 3. DO NOT commit your `.env` file to version control!
# ==========================================

# 1. AI Integration (Unit VI: AI Health Alert System)
# Used to generate the automated municipal advisory text
OPENAI_API_KEY=sk_your_openai_api_key_here
# ANTHROPIC_API_KEY=sk_ant_your_claude_api_key_here

# 2. Geospatial Analytics (Unit VI: GIS Monitor)
# Required for rendering high-fidelity Mapbox satellite and carto tiles
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token_here

# 3. Database Connection (Optional for Production)
# If connecting JalRakshak to a live PostgreSQL telemetry database instead of local CSVs
DATABASE_URL=postgresql://user:password@localhost:5432/jalrakshak_db

# 4. Application Settings
STREAMLIT_ENV=development
DEBUG_MODE=True
